DirectoryIndex index.html
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

RewriteEngine On

# Um unico dominio oficial, com HTTPS.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.apolinariointeriores\.com\.br$ [NC]
RewriteRule ^ https://www.apolinariointeriores.com.br%{REQUEST_URI} [R=301,L,NE]

# Redireciona apenas pedidos externos, sem afetar os rewrites internos.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+servicos(?:/index\.html|/|\.html)(?:[?\s]) [NC]
RewriteRule ^servicos(?:/index\.html|/|\.html)$ /servicos [R=301,L]

# Entrega o HTML da pagina, em vez do HTML inicial de uma SPA.
RewriteRule ^servicos$ servicos/index.html [L]

# Arquivos inexistentes usam o erro 404 nativo e o ErrorDocument acima.
